import threading

class DiningPhilosophers:
    def __init__(self):
        self.forks = [threading.Lock() for _ in range(5)]
        self.limit = threading.Semaphore(4)

    def wantsToEat(self,
                    philosopher: int,
                    pickLeftFork: 'Callable[[], None]',
                    pickRightFork: 'Callable[[], None]',
                    eat: 'Callable[[], None]',
                    putLeftFork: 'Callable[[], None]',
                    putRightFork: 'Callable[[], None]') -> None:
        
        left_fork_id = philosopher
        right_fork_id = (philosopher + 1) % 5

        with self.limit:
            with self.forks[left_fork_id]:
                with self.forks[right_fork_id]:
                    pickLeftFork()
                    pickRightFork()
                    eat()
                    putLeftFork()
                    putRightFork()
